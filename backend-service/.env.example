# Server
PORT=3001
CORS_ORIGINS=http://localhost:3000,https://ai4b2b.site

# Database
NEON_DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Gemini
GEMINI_API_KEY=AIza...

# Security
CRON_SECRET=random-32-char-string
ADMIN_TOKEN=another-random-string

# Generation context
SITE_TOPIC=Description of site topic and target audience
SITE_LANGUAGE=ru

# Pipeline settings
TOPIC_FILTER_THRESHOLD=6
POST_REVIEW_THRESHOLD=7
MAX_TOPIC_RETRIES=3
MAX_POST_RETRIES=2
